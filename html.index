<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crypto Tap Game</title>
    <!-- Telegram Web App SDK -->
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        body {
            background-color: #121212;
            color: #ffffff;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            text-align: center;
            margin: 0;
            padding: 20px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 90vh;
        }
        .header {
            font-size: 1rem;
            opacity: 0.8;
        }
        .score-container {
            font-size: 3.5rem;
            font-weight: bold;
            margin: 10px 0;
            color: #f3ba2f;
            text-shadow: 0 0 20px rgba(243, 186, 47, 0.4);
        }
        .tap-button-container {
            margin: 20px 0;
        }
        .tap-button {
            background: radial-gradient(circle, #ffaa00, #e69500);
            border: 4px solid #fff;
            border-radius: 50%;
            width: 190px;
            height: 190px;
            font-size: 2rem;
            font-weight: bold;
            color: white;
            cursor: pointer;
            box-shadow: 0px 15px 35px rgba(243, 186, 47, 0.5);
            outline: none;
            transition: transform 0.05s ease, box-shadow 0.05s ease;
        }
        .tap-button:active {
            transform: scale(0.90);
            box-shadow: 0px 5px 15px rgba(243, 186, 47, 0.3);
        }
        .energy-container {
            width: 80%;
            margin: 0 auto 20px auto;
        }
        .energy-bar {
            width: 100%;
            height: 14px;
            background: #222;
            border: 2px solid #444;
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 5px;
        }
        .energy-fill {
            height: 100%;
            width: 100%;
            background: linear-gradient(90deg, #00ff88, #00cc66);
            transition: width 0.2s ease;
        }
        .leaderboard {
            background: #1e1e1e;
            border-radius: 12px;
            padding: 15px;
            margin-top: 15px;
            max-height: 150px;
            overflow-y: auto;
            border: 1px solid #333;
        }
        .leaderboard h3 {
            margin: 0 0 10px 0;
            font-size: 1.1rem;
            color: #f3ba2f;
        }
        .leaderboard-item {
            display: flex;
            justify-content: space-between;
            padding: 6px 10px;
            border-bottom: 1px solid #2a2a2a;
            font-size: 0.9rem;
        }
        .leaderboard-item:last-child {
            border-bottom: none;
        }
    </style>
</head>
<body>

    <div>
        <div class="header">
            <p>Player: <span id="username" style="color: #f3ba2f; font-weight: bold;">Loading...</span></p>
        </div>
        <div class="score-container" id="score">0</div>
        <div style="font-size: 0.9rem; opacity: 0.6; letter-spacing: 1px;">COINS</div>
    </div>

    <div class="tap-button-container">
        <button class="tap-button" id="tapBtn">TAP</button>
    </div>

    <div>
        <div class="energy-container">
            <div class="energy-bar">
                <div class="energy-fill" id="energyFill"></div>
            </div>
            <p style="margin: 0; font-size: 0.85rem;"><span id="energy">1000</span> / 1000 Energy</p>
        </div>

        <div class="leaderboard">
            <h3>🏆 Top Players</h3>
            <div id="leaderboardList">Loading leaderboard...</div>
        </div>
    </div>

    <script>
        const tg = window.Telegram.WebApp;
        tg.expand();

        // Automatically switch between local computer and future live backend URL
        const API_URL = window.location.hostname === 'localhost' 
            ? 'http://localhost:3000' 
            : 'https://YOUR-BACKEND-URL.com';

        const telegramId = tg.initDataUnsafe && tg.initDataUnsafe.user ? tg.initDataUnsafe.user.id.toString() : "test_user_123";
        const username = tg.initDataUnsafe && tg.initDataUnsafe.user ? tg.initDataUnsafe.user.first_name : "CryptoGamer";

        document.getElementById('username').innerText = username;

        let score = 0;
        let energy = 1000;
        const maxEnergy = 1000;

        const scoreElement = document.getElementById('score');
        const tapBtn = document.getElementById('tapBtn');
        const energyElement = document.getElementById('energy');
        const energyFill = document.getElementById('energyFill');
        const leaderboardList = document.getElementById('leaderboardList');

        // Fetch user data
        async function initUser() {
            try {
                const response = await fetch(`${API_URL}/api/user`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ telegramId, username })
                });
                const data = await response.json();
                score = data.score;
                energy = data.energy;
                updateUI();
                fetchLeaderboard();
            } catch (err) {
                console.error("Failed to connect to server:", err);
            }
        }

        // Sync score with backend
        async function syncScore() {
            try {
                await fetch(`${API_URL}/api/score`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ telegramId, score, energy })
                });
            } catch (err) {
                console.error("Failed to sync score:", err);
            }
        }

        // Fetch leaderboard data
        async function fetchLeaderboard() {
            try {
                const response = await fetch(`${API_URL}/api/leaderboard`);
                const users = await response.json();
                
                if (users.length === 0) {
                    leaderboardList.innerHTML = "<div>No players yet</div>";
                    return;
                }

                leaderboardList.innerHTML = users.map((user, index) => `
                    <div class="leaderboard-item">
                        <span>#${index + 1} ${user.username}</span>
                        <span style="color: #f3ba2f; font-weight: bold;">${user.score}</span>
                    </div>
                `).join('');
            } catch (err) {
                console.error("Failed to fetch leaderboard:", err);
            }
        }

        function updateUI() {
            scoreElement.innerText = score;
            energyElement.innerText = energy;
            energyFill.style.width = (energy / maxEnergy) * 100 + '%';
        }

        tapBtn.addEventListener('click', () => {
            if (energy > 0) {
                score += 1;
                energy -= 1;
                updateUI();
                syncScore();

                if (tg.HapticFeedback) {
                    tg.HapticFeedback.impactOccurred('light');
                }
            }
        });

        // Regenerate energy
        setInterval(() => {
            if (energy < maxEnergy) {
                energy = Math.min(maxEnergy, energy + 5);
                updateUI();
                syncScore();
            }
        }, 1000);

        // Refresh leaderboard every 5 seconds
        setInterval(fetchLeaderboard, 5000);

        initUser();
    </script>
</body>
</html>